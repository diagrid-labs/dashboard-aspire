<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Authors>Diagrid</Authors>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Diagrid.Aspire.Hosting.Dashboard</RootNamespace>
        <PackageId>Diagrid.Aspire.Hosting.Dashboard</PackageId>
        <AssemblyName>Diagrid.Aspire.Hosting.Dashboard</AssemblyName>
        <IsPackable>true</IsPackable>
        <PackageIcon>/diagrid-logo.png</PackageIcon>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/diagrid-labs/dashboard-aspire</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" Version="13.4.3" />
        <PackageReference Include="CopperDusk.Aspire.Hosting.Yaml" Version="0.0.4" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="../diagrid-logo.png" Link="/diagrid-logo.png" Pack="true" PackagePath="/" >
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="../readme.md" Pack="true" PackagePath="/">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
